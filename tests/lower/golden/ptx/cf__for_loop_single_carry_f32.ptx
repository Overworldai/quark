    mov.u32 %r2, 1;
    mov.f32 %f0, 0f00000000;
    mov.u32 %r3, %r0;
    mov.f32 %f1, %f0;
    setp.lt.u32 %p0, %r3, %r1;
    @!%p0 bra $LEND_1;
$L_2:
