.version 8.4
.target sm_89
.address_size 64

.visible .entry f(

)
{
    .reg .f32 %f0, %f1, %f2, %f3, %f4, %f5, %f6, %f7, %f8, %f9, %f10;

    mov.f32 %f0, 0f3f800000;
    shfl.sync.bfly.b32 %f1, %f0, 16, 31, -1;
    add.f32 %f2, %f0, %f1;
    shfl.sync.bfly.b32 %f3, %f2, 8, 31, -1;
    add.f32 %f4, %f2, %f3;
    shfl.sync.bfly.b32 %f5, %f4, 4, 31, -1;
    add.f32 %f6, %f4, %f5;
    shfl.sync.bfly.b32 %f7, %f6, 2, 31, -1;
    add.f32 %f8, %f6, %f7;
    shfl.sync.bfly.b32 %f9, %f8, 1, 31, -1;
    add.f32 %f10, %f8, %f9;
    ret;
}
