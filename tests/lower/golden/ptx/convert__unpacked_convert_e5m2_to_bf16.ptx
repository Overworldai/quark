.version 8.4
.target sm_89
.address_size 64

.visible .entry f(

)
{
    .reg .b16 %h0, %h1, %h2, %h3, %h4;
    .reg .b32 %b0;
    .reg .f32 %f0, %f1;

    mov.b16 %h0, 0;
    cvt.rn.f16x2.e5m2x2 %b0, %h0;
    mov.b32 {%h3, %h4}, %b0;
    cvt.f32.f16 %f0, %h3;
    cvt.f32.f16 %f1, %h4;
    cvt.rn.bf16.f32 %h1, %f0;
    cvt.rn.bf16.f32 %h2, %f1;
    ret;
}
