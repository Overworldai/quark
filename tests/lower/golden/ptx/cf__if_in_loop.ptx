.version 8.4
.target sm_89
.address_size 64

.visible .entry f(

)
{
    .reg .f32 %f0, %f1, %f2, %f3;
    .reg .pred %p0, %p1, %p2;
    .reg .u32 %r0, %r1, %r2, %r3;

    mov.u32 %r0, 0;
    mov.u32 %r1, 4;
    mov.u32 %r2, 1;
    mov.f32 %f0, 0f3f800000;
    mov.f32 %f1, 0f00000000;
    mov.u32 %r3, %r0;
    setp.lt.u32 %p0, %r3, %r1;
    @!%p0 bra $LEND_1;
$L_2:
    setp.lt.f32 %p1, %f1, %f0;
    @!%p1 bra $ELSE_3;
    mov.f32 %f2, 0f40000000;
    bra $ENDIF_4;
$ELSE_3:
    mov.f32 %f3, 0f40400000;
$ENDIF_4:
    add.u32 %r3, %r3, %r2;
    setp.lt.u32 %p2, %r3, %r1;
    @%p2 bra $L_2;
$LEND_1:
    ret;
}
