.version 8.4
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 _smem_pool[];

.visible .entry f(
    .param .u64 X
)
{
    .reg .u32 %r0, %r1;
    .reg .u64 %rd0, %rd1;

    ld.param.u64 %rd0, [X];
    mov.u32 %r0, _smem_pool;
    cvt.u64.u32 %rd1, %r0;
    mov.u32 %r1, 0;
    cp.async.ca.shared.global.L2::256B [%r0], [%rd0], 4;
    ret;
}
