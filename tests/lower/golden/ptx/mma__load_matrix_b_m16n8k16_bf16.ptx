.version 8.4
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 _smem_pool[];

.visible .entry f(

)
{
    .reg .b32 %b0, %b1;
    .reg .u32 %r0, %r1;
    .reg .u64 %rd0;

    mov.u32 %r0, _smem_pool;
    cvt.u64.u32 %rd0, %r0;
    mov.u32 %r1, 0;
    ld.shared.b32 %b0, [%r0];
    ld.shared.b32 %b1, [%r0 + 16];
    ret;
}
