.version 8.4
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 _smem_pool[];

.visible .entry f(

)
{
    .reg .f32 %f0, %f1, %f2, %f3;
    .reg .u32 %r0, %r1;
    .reg .u64 %rd0;

    mov.u32 %r0, _smem_pool;
    cvt.u64.u32 %rd0, %r0;
    mov.u32 %r1, 0;
    ld.shared.f32 %f0, [%r0];
    ld.shared.f32 %f1, [%r0 + 4];
    ld.shared.f32 %f2, [%r0 + 256];
    ld.shared.f32 %f3, [%r0 + 260];
    ret;
}
